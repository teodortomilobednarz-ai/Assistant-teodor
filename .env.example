# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored and must never be committed.

# --- AI engine -------------------------------------------------------------
# Google Gemini API key — powers the AI analysis (free tier available).
# Get one for free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Database --------------------------------------------------------------
# PostgreSQL connection string (free tier at https://neon.tech).
DATABASE_URL=

# --- Authentication (Auth.js) ----------------------------------------------
# A random secret used to encrypt sessions/tokens.
# Generate one with: openssl rand -base64 33
AUTH_SECRET=

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI in dev: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Billing (Stripe) ------------------------------------------------------
# Test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret (https://dashboard.stripe.com/test/webhooks).
# Endpoint to add: https://<your-domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs for each plan/interval (create them under your Product).
# Monthly prices are required; yearly are optional.
STRIPE_PRICE_ESSENTIEL_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_ESSENTIEL_YEARLY=
STRIPE_PRICE_PRO_YEARLY=
# Public base URL used for Stripe redirect URLs (no trailing slash).
NEXT_PUBLIC_APP_URL=https://assistant-teodor.vercel.app

# --- Admin -----------------------------------------------------------------
# Comma-separated emails granted full Pro access without paying (owner/testers).
ADMIN_EMAILS=
