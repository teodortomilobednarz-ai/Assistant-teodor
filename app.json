{
  "expo": {
    "name": "Nutrascan",
    "slug": "nutrascan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "nutrascan",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080810"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nutrascan.app",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "Nutrascan utilise cet identifiant pour vous afficher des publicités pertinentes. Vous pouvez refuser sans impact sur les fonctionnalités de l'app."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080810"
      },
      "package": "com.nutrascan.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withPrivacyManifest",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7C3AED",
          "defaultChannel": "reminders",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nutrascan accède à vos photos pour analyser vos repas.",
          "cameraPermission": "Nutrascan accède à votre caméra pour scanner vos aliments."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Nutrascan utilise cet identifiant pour vous afficher des publicités pertinentes. Vous pouvez refuser sans impact sur les fonctionnalités de l'app."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "EXPO_PUBLIC_ADMOB_ANDROID_APP_ID",
          "iosAppId": "EXPO_PUBLIC_ADMOB_IOS_APP_ID",
